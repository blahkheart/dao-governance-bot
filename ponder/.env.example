# Mainnet RPC URL used for fetching blockchain data. Alchemy is recommended.
PONDER_RPC_URL_BASE_MAINNET=https://your-rpc-endpoint.com/
PONDER_RPC_URL_BASE_SEPOLIA=
TARGET_CHAIN_ID=8453
START_BLOCK=12345678 # Block number to start indexing from
HISTORICAL_EVENTS_CUTOFF=12345679 # Events before this block are considered historical
DAO_GOVERNOR_ADDRESS=0x123... # Your DAO Governor contract address
NEYNAR_API_KEY=your-api-key # Get from https://neynar.com/
SIGNER_UUID=your-signer-uuid # UUID for the Farcaster signer

# (Optional) Postgres database URL. If not provided, SQLite will be used. 
DATABASE_URL=

# Farcaster Configuration
FARCASTER_BOT_MNEMONIC="your mnemonic phrase here" # Mnemonic for the Farcaster account

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/dao-governance-bot # MongoDB connection URI

# Other Configuration
PORT=3000 # Port for the API server
LOG_LEVEL=info # Log level (debug, info, warn, error)
ERC20_ADDRESS=0x123... # Your ERC20 token contract address (if applicable)

# API Keys
ALCHEMY_API_KEY=your-alchemy-key # Alchemy API key (if applicable)
ETHERSCAN_API_KEY=your-etherscan-key # Etherscan API key (if applicable)